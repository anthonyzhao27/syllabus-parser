# Backend environment variables (FastAPI)
# Copy this file to backend/.env and fill in real values.
# In production (ENVIRONMENT=production) the app fails to start unless the
# critical secrets below are set and ALLOWED_ORIGINS is not the localhost
# default. See backend/app/config.py.

# Deployment environment: "development" (default) or "production".
ENVIRONMENT=development

# OpenAI (LLM extraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision model + OCR settings for image-based (scanned) PDFs.
VISION_MODEL=gpt-4o
VISION_DPI=150
VISION_DETAIL=low
VISION_MAX_PAGES=20
# Cache extracted text by file hash to avoid re-billing identical uploads.
EXTRACTION_CACHE_ENABLED=true

# Supabase (database / auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated list of allowed CORS origins.
# Must be overridden in production (do not ship the localhost default).
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size in megabytes.
MAX_FILE_SIZE_MB=10
